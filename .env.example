# Guesty Booking Engine API
# Generate client_id / client_secret in Guesty: Growth > Distribution > Booking Engine API > Create a new API key
GUESTY_BE_CLIENT_ID=
GUESTY_BE_CLIENT_SECRET=

# Confirmed by Guesty support for this project
GUESTY_ACCOUNT_ID=6a32d810df13a890fa85e1b4

# Optional overrides (defaults match Guesty's documented endpoints)
# GUESTY_BE_TOKEN_URL=https://booking.guesty.com/oauth2/token
# GUESTY_BE_API_BASE_URL=https://booking.guesty.com/api

# Wompi
# Keys and secrets live in the Wompi dashboard: Desarrollo > Programadores
# Use the pub_test_ / test_integrity_ / test_events_ set for local development
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
